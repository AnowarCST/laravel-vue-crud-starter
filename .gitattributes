# Shell scripts copied into Linux images must keep LF endings.
*.sh text eol=lf
docker/** text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

/.github export-ignore
CHANGELOG.md export-ignore
