# Dependencies
/node_modules
/vendor

# Build output (Vite) and runtime links
/public/build
/public/hot
/public/storage

# Secrets / local environment (.env.example and .env.testing are committed:
# .env.testing only selects the in-memory SQLite test database)
.env
.env.backup
.env.production
.env.*.local
/storage/*.key
/auth.json

# Tooling caches and reports
.phpunit.cache
.phpunit.result.cache
/coverage
reports/
npm-debug.log
yarn-error.log
Homestead.json
Homestead.yaml

# AI coding assistants: local state and personal settings (the shared
# .claude/settings.json and .claude/commands/ are committed)
/.claude/worktrees/
/.claude/settings.local.json
/CLAUDE.local.md

# Editors / OS
.idea
.vscode
*.code-workspace
.DS_Store
Thumbs.db

# Playwright end-to-end tests: reports, traces and the generated stack state
# (random throwaway secrets written by tests/e2e/setup/start-stack.sh)
/tests/e2e/test-results/
/tests/e2e/playwright-report/
/tests/e2e/.stack/
