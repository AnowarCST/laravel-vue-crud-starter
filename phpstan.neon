includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    # Level 10 is the strictest level. The code passes it without a baseline
    # or ignored errors; keep it that way.
    level: 10
    # Read model casts from the body of casts() rather than from its
    # `array<string, string>` return type, so cast attributes (enums, dates,
    # hashed passwords) get their cast types.
    parseModelCastsMethod: true
    paths:
        - app
        - bootstrap/app.php
        - bootstrap/providers.php
        - config
        - database
        - routes
        - tests
