# -----------------------------------------------------------------------------
# Laravel + Vue CRUD starter - environment template
#
#   cp .env.example .env
#   php artisan key:generate        (or: docker compose exec app php artisan key:generate)
#
# Never commit .env. Every secret below is intentionally empty: fill it with a
# long random value (e.g. `openssl rand -base64 32`), never a dictionary word.
# -----------------------------------------------------------------------------

APP_NAME="Laravel Starter"
APP_ENV=local
APP_KEY=
# Keep false by default. Set APP_DEBUG=true only on your own machine while
# debugging - debug pages expose environment values and stack traces.
APP_DEBUG=false
# Must match the URL you browse to (docker compose publishes APP_PORT).
# Use https:// in production; session cookies then become Secure automatically.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Only when behind a load balancer / reverse proxy: comma-separated proxy IPs
# or CIDRs whose X-Forwarded-* headers are trusted. Leave empty otherwise.
TRUSTED_PROXIES=
# Extra origins (comma-separated) allowed to call the API with CORS.
# APP_URL is always allowed.
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug | info | notice | warning | error ... use warning or higher in production.
LOG_LEVEL=info

# --- Database (MySQL 8.4) ----------------------------------------------------
# docker compose creates the database and DB_USERNAME on first start using
# these values; DB_HOST=db is the compose service name (use 127.0.0.1 without
# Docker). DB_USERNAME must not be root.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
# Used only by the MySQL container for administration; keep it different from
# DB_PASSWORD. The application never connects as root.
DB_ROOT_PASSWORD=

# --- Sessions / cache / queue ------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Secure (HTTPS-only) cookies default to on when APP_URL starts with https://.
# Uncomment to force it explicitly in production (leave unset rather than empty).
# SESSION_SECURE_COOKIE=true

CACHE_STORE=database
CACHE_PREFIX=
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Passport (OAuth2 / personal access tokens) ------------------------------
# By default `php artisan passport:keys` writes storage/oauth-private.key and
# storage/oauth-public.key (gitignored, mode 600). In containers/production you
# can instead provide the PEM contents here (quoted, with \n line breaks) or via
# your secret manager. Rotating these keys invalidates every issued token.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# --- Mail --------------------------------------------------------------------
# "log" writes mails to the log for local development. Configure smtp
# (MAIL_SCHEME=smtps or port 587 with STARTTLS) for real delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Optional object storage -------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend (Vite) ---------------------------------------------------------
# Only VITE_* variables are exposed to browser code - never put secrets in them.
VITE_APP_NAME="${APP_NAME}"

# --- Docker Compose (local development only) ---------------------------------
# Host ports, bound to 127.0.0.1 only.
APP_PORT=8000
VITE_PORT=5173
# Opt-in MySQL port, see docker-compose.db-port.yml.
DB_FORWARD_PORT=3307
# Linux hosts: set to the output of `id -u` / `id -g` so files the container
# writes into the bind mount stay owned by you.
HOST_UID=1000
HOST_GID=1000
